---
/* Página de inicio, una por idioma, ordenada como la de kyoto.travel: portada, bienvenida y una sección por grupo
   del menú (lib/groups.ts). Los grupos de contenido salen como tarjetas; los consejos de viaje, como una fila de
   iconos.

     Portada ─ Bienvenida ─ Descubre ─ Qué hacer ─ Lugares ─ Consejos de viaje
                            (tarjetas) (tarjetas)  (tarjetas) (iconos)

   Cada sección lleva el id de su grupo (#places): la ruta de navegación de las páginas enlaza ahí. */
import { Image } from 'astro:assets';
import palmsImage from '../../assets/img/catatumbo-02.jpg';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Icon, { type IconName } from '../../components/Icon.astro';
import { LANGS, useTranslations, type Lang, type UIKey } from '../../i18n/ui';
import { navIn, pageUrl, urlOf, type PageKey } from '../../lib/pages';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const nav = await navIn(lang);
const lightning = await urlOf('lightning', lang);

/* Grupo que se muestra como fila de iconos en vez de tarjetas. */
const TIPS_GROUP = 'tips';

/* Colores e iconos de las tarjetas, por página. */
const CARD: Partial<Record<PageKey, { tone: string; icon: IconName }>> = {
  lightning: { tone: 'communities', icon: 'bolt' },
  history: { tone: 'public', icon: 'book' },
  seasons: { tone: 'heritage', icon: 'calendar' },
  responsible: { tone: 'protected', icon: 'heart' },
  tours: { tone: 'protected', icon: 'boat' },
  photography: { tone: 'communities', icon: 'camera' },
  park: { tone: 'protected', icon: 'leaf' },
  villages: { tone: 'heritage', icon: 'stilts' },
  itinerary: { tone: 'public', icon: 'route' },
  lodging: { tone: 'communities', icon: 'bed' },
};
const CARD_FALLBACK = { tone: 'public', icon: 'compass' as IconName };

/* Los consejos de viaje: icono y texto corto (i18n/ui.ts) por página. */
const TIP: Partial<Record<PageKey, { icon: IconName; title: UIKey; body: UIKey }>> = {
  'getting-there': { icon: 'boat', title: 'tips.c1h', body: 'tips.c1' },
  packing: { icon: 'backpack', title: 'tips.c3h', body: 'tips.c3' },
  safety: { icon: 'shield', title: 'tips.c4h', body: 'tips.c4' },
  today: { icon: 'moon', title: 'tips.c5h', body: 'tips.c5' },
};
---
<Base lang={lang} title={t('site.title')} description={t('site.desc')}>
  <Hero lang={lang} cta={lightning} />

  <section class="ct-section welcome" id="bienvenida">
    <p class="watermark welcome-mark" aria-hidden="true">Catatumbo</p>
    <div class="welcome-grid">
      <div class="welcome-head">
        <div class="ct-index mono-eyebrow">{t('welcome.index')}</div>
        <h2 class="ct-header-title display-section">{t('welcome.title')}</h2>
      </div>
      <figure class="welcome-photo">
        <Image src={palmsImage} alt={t('welcome.photoAlt')} widths={[420, 640, 900]} sizes="(max-width: 650px) 100vw, 34vw" format="webp" />
      </figure>
      <div class="welcome-copy">
        <p class="ct-body copy-body">{t('welcome.body')}</p>
      </div>
    </div>
  </section>

  {nav.map(({ group, pages }, i) => (
    <section class:list={['ct-section', { 'ct-section-sunk': i % 2 === 0 }]} id={group}>
      <div class="ct-index mono-eyebrow">{t(`group.${group}`)}</div>
      <h2 class="ct-header-title display-section">{t(`group.${group}.title`)}</h2>

      {group === TIPS_GROUP ? (
        <ul class="tips">
          {pages.map((p) => {
            const tip = TIP[p.data.key];
            return (
              <li>
                <a class="tip-link" href={pageUrl(p)}>
                  <span class="tip-icon"><Icon name={tip?.icon ?? 'compass'} size={34} /></span>
                  <span class="tip-title display-list">{tip ? t(tip.title) : p.data.title}</span>
                  <span class="tip-body copy-small">{tip ? t(tip.body) : p.data.description}</span>
                </a>
              </li>
            );
          })}
        </ul>
      ) : (
        <div class="ct-places">
          {pages.map((p, n) => {
            const card = CARD[p.data.key] ?? CARD_FALLBACK;
            return (
              <article class={`ct-place ct-place-${card.tone}`}>
                <span class="card-icon"><Icon name={card.icon} size={26} /></span>
                <span class="ct-place-number">{String(n + 1).padStart(2, '0')}</span>
                <h3 class="display-card">{p.data.title}</h3>
                <p class="copy-card">{p.data.description}</p>
                <a href={pageUrl(p)}>{t('card.go')}</a>
              </article>
            );
          })}
        </div>
      )}
    </section>
  ))}
</Base>
