---
/* Globo terráqueo (las Américas), trazado con potrace desde la imagen de referencia. Toma el color del texto. */
interface Props { size?: number }
const { size = 24 } = Astro.props;

/* Unidades del dibujo (viewBox) y radio exterior del aro original. */
const VIEW = 870;
const CENTER = VIEW / 2;
const OUTER_R = 431.5;

/* El aro trazado mide 12 unidades (~0,35 px en pantalla): casi invisible. Encima va uno de 1,6 px reales,
   como el trazo de los demás iconos, con el borde exterior en el mismo sitio. */
const RING_PX = 1.6;
const ring = RING_PX * VIEW / size;
