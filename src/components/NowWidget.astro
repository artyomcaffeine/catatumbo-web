---
/* Widget flotante bajo la barra superior: hora local del lago | cielo y temperatura en Congo Mirador.
   Ejemplo: 🕒 9:42 p. m. | ☾ 27,4 °C. Sin JavaScript no se muestra; sin conexión, solo la hora. */
import Icon from './Icon.astro';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---
<aside class="now mono-nav" data-now data-lang={lang} aria-label={t('now.aria')} hidden>
  <span class="now-part"><Icon name="clock" size={18} /><time data-clock></time></span>
  <span class="now-part" data-weather hidden>
    <span class="now-sky" data-sky="day" hidden><Icon name="sun" size={18} /></span>
    <span class="now-sky" data-sky="night" hidden><Icon name="moon" size={18} /></span>
    <span class="now-sky" data-sky="storm" hidden><Icon name="bolt" size={18} /></span>
    <span data-temp></span>
  </span>
</aside>

<script>
  import { ZONE } from '../lib/lake';
  import { fetchNow, type Now } from '../lib/weather';

  const MINUTE_MS = 60 * 1000;

  function start() {
    const root = document.querySelector<HTMLElement>('[data-now]');
    if (!root) {
      return;
    }

    const lang = root.dataset.lang ?? 'es';
    const clock = root.querySelector<HTMLElement>('[data-clock]')!;
    const time = new Intl.DateTimeFormat(lang, { hour: 'numeric', minute: '2-digit', timeZone: ZONE });
    const temp = new Intl.NumberFormat(lang, { style: 'unit', unit: 'celsius', maximumFractionDigits: 1 });
    let timer = 0;

    /* Cielo y temperatura. Si falla, se queda la última lectura (o solo la hora). */
    function show(now: Now | null) {
      if (!now) {
        return;
      }

      root!.querySelector<HTMLElement>('[data-temp]')!.textContent = temp.format(now.temp);
      root!.querySelectorAll<HTMLElement>('[data-sky]').forEach((icon) => { icon.hidden = icon.dataset.sky !== now.sky; });
      root!.querySelector<HTMLElement>('[data-weather]')!.hidden = false;
    }

    /* La hora del lago, no la del visitante. Se repite justo al cambiar el minuto (12:59:59 → 13:00:00),
       no cada N segundos, para no ir con retraso. De paso pide el tiempo: fetchNow() devuelve la lectura
       guardada hasta que tiene 15 minutos y solo entonces llama a Open-Meteo. */
    function tick() {
      clock.textContent = time.format(new Date());
      fetchNow().then(show);

      clearTimeout(timer);
      timer = window.setTimeout(tick, MINUTE_MS - (Date.now() % MINUTE_MS));
    }

    tick();
    root.hidden = false;

    /* Los teléfonos pausan los temporizadores con la pestaña en segundo plano: al volver, se actualiza al momento. */
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        return;
      }

      tick();
    });
  }

  start();
</script>
